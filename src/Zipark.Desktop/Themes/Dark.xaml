<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Zipark palette (dark). -->
  <Color x:Key="Color.Accent">#3FB6C0</Color>
  <SolidColorBrush x:Key="Brush.Window" Color="#161B1D"/>
  <SolidColorBrush x:Key="Brush.Sidebar" Color="#1C2225"/>
