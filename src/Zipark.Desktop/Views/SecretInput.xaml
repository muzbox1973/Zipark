<UserControl x:Class="Zipark.Desktop.Views.SecretInput"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root">
  <StackPanel>
    <Grid>
      <PasswordBox x:Name="Box" PasswordChanged="OnPasswordChanged" Padding="8,5,36,5" AutomationProperties.Name="{Binding Label, ElementName=Root}"/>
      <TextBox x:Name="Plain" Visibility="Collapsed" Padding="8,5,36,5" TextChanged="OnPlainChanged" AutomationProperties.Name="{Binding Label, ElementName=Root}"/>
      <ToggleButton x:Name="Eye" HorizontalAlignment="Right" Width="30" Margin="0,0,2,0" Background="Transparent" BorderThickness="0" Cursor="Hand"
                    Checked="OnShow" Unchecked="OnHide" ToolTip="{DynamicResource s.pw.showHide}" Focusable="True">
        <ToggleButton.Template>
          <ControlTemplate TargetType="ToggleButton">
            <Border Background="Transparent">
              <TextBlock x:Name="g" Text="&#xE7B3;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14"
                         HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource Brush.TextMuted}"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="g" Property="Text" Value="&#xED1A;"/>
                <Setter TargetName="g" Property="Foreground" Value="{DynamicResource Brush.Accent}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </ToggleButton.Template>
      </ToggleButton>
    </Grid>
    <Grid x:Name="Meter" Margin="0,6,0,0" Visibility="Collapsed">
      <Grid.ColumnDefinitions>
        <ColumnDefinition/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <ProgressBar x:Name="Bar" Maximum="100" Height="4" VerticalAlignment="Center"/>
      <TextBlock x:Name="BarText" Grid.Column="1" Margin="8,0,0,0" FontSize="12" Foreground="{DynamicResource Brush.TextMuted}"/>
    </Grid>
  </StackPanel>
</UserControl>
