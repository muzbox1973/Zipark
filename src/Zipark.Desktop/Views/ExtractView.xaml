<UserControl x:Class="Zipark.Desktop.Views.ExtractView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="clr-namespace:Zipark.Desktop.Views">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="32,28,32,90" MaxWidth="1000">
      <TextBlock Text="{DynamicResource s.extract.title}" Style="{StaticResource Text.Title}"/>
      <TextBlock Text="{DynamicResource s.extract.subtitle}" Style="{StaticResource Text.Subtitle}" Margin="0,0,0,20"/>

      <Border Style="{StaticResource Card}" Margin="0,0,0,14">
        <StackPanel>
          <DockPanel Margin="0,0,0,8">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
              <Button Content="{DynamicResource s.extract.add}" Command="{Binding AddCommand}" Margin="0,0,6,0"/>
              <Button Content="{DynamicResource s.common.remove}" Command="{Binding RemoveCommand}" Margin="0,0,6,0"/>
              <Button Content="{DynamicResource s.common.clear}" Command="{Binding ClearCommand}" Style="{StaticResource Button.Subtle}"/>
            </StackPanel>
            <TextBlock Text="{DynamicResource s.extract.archives}" Style="{StaticResource Text.Section}" VerticalAlignment="Center" Margin="0"/>
          </DockPanel>
          <ListBox ItemsSource="{Binding Archives}" SelectedItem="{Binding Selected}" MinHeight="90" MaxHeight="220"
                   Background="{DynamicResource Brush.Input}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <StackPanel Margin="2">
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE7B8;" FontFamily="{StaticResource Font.Icons}" Foreground="{DynamicResource Brush.Accent}" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding Path}" Margin="8,0,0,0" TextTrimming="CharacterEllipsis"/>
                  </StackPanel>
                  <TextBlock Text="{Binding Status}" Style="{StaticResource Text.Muted}" FontSize="12" Margin="24,0,0,0"/>
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <TextBlock Text="{DynamicResource s.extract.batchHint}" Style="{StaticResource Text.Muted}" FontSize="12" Margin="0,6,0,0"/>
        </StackPanel>
      </Border>

      <Border Style="{StaticResource Card}" Margin="0,0,0,14">
        <StackPanel>
          <TextBlock Text="{DynamicResource s.extract.destination}" Style="{StaticResource Text.Section}"/>
          <RadioButton Content="{DynamicResource s.extract.sameFolder}" IsChecked="{Binding ToSameFolder}" GroupName="dest"/>
          <DockPanel Margin="0,4,0,0">
            <RadioButton DockPanel.Dock="Left" Content="{DynamicResource s.extract.customFolder}" IsChecked="{Binding ToCustomFolder}" GroupName="dest"/>
            <Button DockPanel.Dock="Right" Content="{DynamicResource s.common.browse}" Command="{Binding BrowseCommand}" Margin="8,0,0,0"/>
            <TextBox Text="{Binding Destination, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding ToCustomFolder}"/>
          </DockPanel>
          <CheckBox Content="{DynamicResource s.extract.subfolder}" IsChecked="{Binding CreateSubfolder}" Margin="0,10,0,0"/>
          <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
            <TextBlock Text="{DynamicResource s.extract.conflict}" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <ComboBox Width="260" ItemsSource="{Binding ConflictChoices}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Conflict}"/>
          </StackPanel>
          <CheckBox Content="{DynamicResource s.extract.openAfter}" IsChecked="{Binding OpenAfter}" Margin="0,10,0,0"/>
        </StackPanel>
      </Border>

      <Border Style="{StaticResource Card}" Margin="0,0,0,14">
        <StackPanel>
          <TextBlock Text="{DynamicResource s.extract.password}" Style="{StaticResource Text.Section}"/>
          <v:SecretInput x:Name="Pw" Width="300" HorizontalAlignment="Left" Label="{DynamicResource s.pw.password}"/>
          <TextBlock Text="{DynamicResource s.extract.passwordHint}" Style="{StaticResource Text.Muted}" FontSize="12" Margin="0,6,0,0"/>
        </StackPanel>
      </Border>

      <Border Style="{StaticResource Card}" Margin="0,0,0,14" Background="{DynamicResource Brush.AccentSoft}" BorderThickness="0">
        <StackPanel Orientation="Horizontal">
          <TextBlock Text="&#xE83D;" FontFamily="{StaticResource Font.Icons}" Foreground="{DynamicResource Brush.Accent}" VerticalAlignment="Top" Margin="0,2,10,0"/>
          <TextBlock Text="{DynamicResource s.extract.safety}" TextWrapping="Wrap" MaxWidth="820"/>
        </StackPanel>
      </Border>

      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button Style="{StaticResource Button.Accent}" Command="{Binding StartCommand}" Padding="22,8">
          <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE896;" FontFamily="{StaticResource Font.Icons}" VerticalAlignment="Center"/><TextBlock Text="{DynamicResource s.extract.start}" Margin="8,0,0,0"/></StackPanel>
        </Button>
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</UserControl>
