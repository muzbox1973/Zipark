<UserControl x:Class="Zipark.Desktop.Views.PasswordView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="clr-namespace:Zipark.Desktop.Views"
             xmlns:infra="clr-namespace:Zipark.Desktop.Infrastructure">
  <UserControl.Resources>
    <infra:StrengthBrushConverter x:Key="StrengthBrush"/>
    <infra:BoolToVisibilityConverter x:Key="Vis"/>
  </UserControl.Resources>
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="32,28,32,90" MaxWidth="1000">
      <TextBlock Text="{DynamicResource s.pwpage.title}" Style="{StaticResource Text.Title}"/>
      <TextBlock Text="{DynamicResource s.pwpage.subtitle}" Style="{StaticResource Text.Subtitle}" Margin="0,0,0,20"/>
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="3*"/>
          <ColumnDefinition Width="16"/>
          <ColumnDefinition Width="2*"/>
        </Grid.ColumnDefinitions>
        <Border Style="{StaticResource Card}">
          <StackPanel>
            <TextBlock Text="{DynamicResource s.pw.password}" Style="{StaticResource Text.Label}"/>
            <v:SecretInput x:Name="Pw" Label="{DynamicResource s.pw.password}"/>
            <TextBlock Text="{DynamicResource s.pw.confirm}" Style="{StaticResource Text.Label}" Margin="0,12,0,4"/>
            <v:SecretInput x:Name="Confirm" Label="{DynamicResource s.pw.confirm}"/>
            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
              <TextBlock Text="&#xE73E;" FontFamily="{StaticResource Font.Icons}" Foreground="{DynamicResource Brush.Success}" VerticalAlignment="Center"
                         Visibility="{Binding Matches, Converter={StaticResource Vis}}"/>
              <TextBlock Text="{DynamicResource s.pw.match}" Foreground="{DynamicResource Brush.Success}" Margin="6,0,0,0" Visibility="{Binding Matches, Converter={StaticResource Vis}}"/>
            </StackPanel>

            <TextBlock Text="{DynamicResource s.pw.strength}" Style="{StaticResource Text.Label}" Margin="0,16,0,6"/>
            <ProgressBar Value="{Binding StrengthValue, Mode=OneWay}" Maximum="100" Height="8" Foreground="{Binding Strength, Converter={StaticResource StrengthBrush}}"/>
            <DockPanel Margin="0,6,0,0">
              <TextBlock DockPanel.Dock="Right" Text="{Binding Entropy}" Style="{StaticResource Text.Muted}" FontSize="12"/>
              <TextBlock Text="{Binding StrengthText}" FontWeight="SemiBold" Foreground="{Binding Strength, Converter={StaticResource StrengthBrush}}"/>
            </DockPanel>
            <ItemsControl ItemsSource="{Binding Hints}" Margin="0,10,0,0">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <StackPanel Orientation="Horizontal" Margin="0,2">
                    <TextBlock Text="&#xE946;" FontFamily="{StaticResource Font.Icons}" Foreground="{DynamicResource Brush.TextMuted}" Margin="0,2,8,0" VerticalAlignment="Top"/>
                    <TextBlock Text="{Binding}" TextWrapping="Wrap" Style="{StaticResource Text.Muted}"/>
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Button Style="{StaticResource Button.Accent}" Content="{DynamicResource s.pwpage.use}" Command="{Binding UseCommand}" HorizontalAlignment="Left" Margin="0,16,0,0"/>
          </StackPanel>
        </Border>
        <Border Grid.Column="2" Style="{StaticResource Card}">
          <StackPanel>
            <TextBlock Text="{DynamicResource s.pwpage.guide}" Style="{StaticResource Text.Section}"/>
            <TextBlock Text="{DynamicResource s.pwpage.g1t}" FontWeight="SemiBold"/>
            <TextBlock Text="{DynamicResource s.pwpage.g1}" Style="{StaticResource Text.Muted}" Margin="0,2,0,10"/>
            <TextBlock Text="{DynamicResource s.pwpage.g2t}" FontWeight="SemiBold"/>
            <TextBlock Text="{DynamicResource s.pwpage.g2}" Style="{StaticResource Text.Muted}" Margin="0,2,0,10"/>
            <TextBlock Text="{DynamicResource s.pwpage.g3t}" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Warning}"/>
            <TextBlock Text="{DynamicResource s.pwpage.g3}" Style="{StaticResource Text.Muted}" Margin="0,2,0,10"/>
            <TextBlock Text="{DynamicResource s.pwpage.g4t}" FontWeight="SemiBold"/>
            <TextBlock Text="{DynamicResource s.pwpage.g4}" Style="{StaticResource Text.Muted}" Margin="0,2,0,0"/>
          </StackPanel>
        </Border>
      </Grid>
    </StackPanel>
  </ScrollViewer>
</UserControl>
