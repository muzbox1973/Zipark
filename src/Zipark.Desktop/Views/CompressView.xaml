<UserControl x:Class="Zipark.Desktop.Views.CompressView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="clr-namespace:Zipark.Desktop.Views"
             xmlns:infra="clr-namespace:Zipark.Desktop.Infrastructure">
  <UserControl.Resources>
    <infra:BoolToVisibilityConverter x:Key="Vis"/>
    <infra:BoolToVisibilityConverter x:Key="NotVis" Invert="True"/>
  </UserControl.Resources>
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="32,28,32,90" MaxWidth="1000">
      <TextBlock Text="{DynamicResource s.compress.title}" Style="{StaticResource Text.Title}"/>
      <TextBlock Text="{DynamicResource s.compress.subtitle}" Style="{StaticResource Text.Subtitle}" Margin="0,0,0,20"/>

      <!-- Sources -->
      <Border Style="{StaticResource Card}" Margin="0,0,0,14">
        <StackPanel>
          <DockPanel Margin="0,0,0,8">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
              <Button Content="{DynamicResource s.compress.addFiles}" Command="{Binding AddFilesCommand}" Margin="0,0,6,0"/>
              <Button Content="{DynamicResource s.compress.addFolder}" Command="{Binding AddFolderCommand}" Margin="0,0,6,0"/>
              <Button Content="{DynamicResource s.common.remove}" Command="{Binding RemoveCommand}" Margin="0,0,6,0"/>
              <Button Content="{DynamicResource s.common.clear}" Command="{Binding ClearCommand}" Style="{StaticResource Button.Subtle}"/>
            </StackPanel>
            <TextBlock Text="{DynamicResource s.compress.sources}" Style="{StaticResource Text.Section}" VerticalAlignment="Center" Margin="0"/>
          </DockPanel>
          <ListBox ItemsSource="{Binding Sources}" SelectedItem="{Binding SelectedSource}" MinHeight="90" MaxHeight="180"
                   Background="{DynamicResource Brush.Input}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1"
                   AutomationProperties.Name="{DynamicResource s.compress.sources}">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <StackPanel Orientation="Horizontal" Margin="2">
                  <TextBlock Text="&#xE8A5;" FontFamily="{StaticResource Font.Icons}" Foreground="{DynamicResource Brush.Accent}" VerticalAlignment="Center"/>
                  <TextBlock Text="{Binding}" Margin="8,0,0,0" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <TextBlock Text="{Binding SourceSummary}" Style="{StaticResource Text.Muted}" FontSize="12" Margin="0,6,0,0"/>
        </StackPanel>
      </Border>

      <!-- Output & format -->
      <Border Style="{StaticResource Card}" Margin="0,0,0,14">
        <StackPanel>
          <TextBlock Text="{DynamicResource s.compress.output}" Style="{StaticResource Text.Section}"/>
          <DockPanel Margin="0,0,0,12">
            <Button DockPanel.Dock="Right" Content="{DynamicResource s.common.browse}" Command="{Binding BrowseOutputCommand}" Margin="8,0,0,0"/>
            <TextBox Text="{Binding Output, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{DynamicResource s.compress.output}"/>
          </DockPanel>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition/>
              <ColumnDefinition Width="16"/>
              <ColumnDefinition/>
              <ColumnDefinition Width="16"/>
              <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <StackPanel>
              <TextBlock Text="{DynamicResource s.compress.format}" Style="{StaticResource Text.Label}"/>
              <ComboBox ItemsSource="{Binding Formats}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Format}"/>
            </StackPanel>
            <StackPanel Grid.Column="2">
              <TextBlock Text="{DynamicResource s.compress.level}" Style="{StaticResource Text.Label}"/>
              <ComboBox ItemsSource="{Binding Levels}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Level}"/>
            </StackPanel>
            <StackPanel Grid.Column="4">
              <TextBlock Text="{DynamicResource s.compress.threads}" Style="{StaticResource Text.Label}"/>
              <ComboBox ItemsSource="{Binding ThreadChoices}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Threads}"/>
            </StackPanel>
          </Grid>

          <!-- Expert options -->
          <Grid Margin="0,12,0,0" Visibility="{Binding Expert, Source={x:Static infra:UiState.Instance}, Converter={StaticResource Vis}}">
            <Grid.ColumnDefinitions>
              <ColumnDefinition/>
              <ColumnDefinition Width="16"/>
              <ColumnDefinition/>
              <ColumnDefinition Width="16"/>
              <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <StackPanel>
              <TextBlock Text="{DynamicResource s.compress.method}" Style="{StaticResource Text.Label}"/>
              <ComboBox ItemsSource="{Binding Methods}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Method}"/>
            </StackPanel>
            <StackPanel Grid.Column="2" IsEnabled="{Binding IsSevenZip}">
              <TextBlock Text="{DynamicResource s.compress.dictionary}" Style="{StaticResource Text.Label}"/>
              <ComboBox ItemsSource="{Binding Dictionaries}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding DictionaryMb}"/>
            </StackPanel>
            <StackPanel Grid.Column="4" IsEnabled="{Binding IsSevenZip}">
              <TextBlock Text="{DynamicResource s.compress.solid}" Style="{StaticResource Text.Label}"/>
              <ComboBox ItemsSource="{Binding SolidModes}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding SolidMode}"/>
            </StackPanel>
          </Grid>

          <StackPanel Margin="0,12,0,0">
            <CheckBox Content="{DynamicResource s.compress.each}" IsChecked="{Binding EachSeparately}"/>
            <CheckBox Content="{DynamicResource s.compress.verify}" IsChecked="{Binding VerifyAfter}"/>
          </StackPanel>
        </StackPanel>
      </Border>

      <!-- Split -->
      <Border Style="{StaticResource Card}" Margin="0,0,0,14" IsEnabled="{Binding SupportsSplit}">
        <StackPanel>
          <CheckBox IsChecked="{Binding Split}" FontWeight="SemiBold" Content="{DynamicResource s.compress.split}"/>
          <StackPanel Orientation="Horizontal" Margin="24,6,0,0" Visibility="{Binding Split, Converter={StaticResource Vis}}">
            <ComboBox Width="180" ItemsSource="{Binding SplitPresets}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding SplitPreset}"/>
            <TextBox Width="140" Margin="8,0,0,0" Text="{Binding CustomSplit, UpdateSourceTrigger=PropertyChanged}" Visibility="{Binding IsCustomSplit, Converter={StaticResource Vis}}"
                     ToolTip="{DynamicResource s.split.customHint}"/>
            <TextBlock Text="{DynamicResource s.split.customHint}" Style="{StaticResource Text.Muted}" FontSize="12" Margin="10,0,0,0" VerticalAlignment="Center"
                       Visibility="{Binding IsCustomSplit, Converter={StaticResource Vis}}"/>
          </StackPanel>
        </StackPanel>
      </Border>

      <!-- Encryption -->
      <Border Style="{StaticResource Card}" Margin="0,0,0,14" IsEnabled="{Binding SupportsEncryption}">
        <StackPanel>
          <CheckBox IsChecked="{Binding Encrypt}" FontWeight="SemiBold" Content="{DynamicResource s.compress.encrypt}"/>
          <StackPanel Margin="24,8,0,0" Visibility="{Binding Encrypt, Converter={StaticResource Vis}}">
            <TextBlock Text="{DynamicResource s.compress.presetPw}" Foreground="{DynamicResource Brush.Success}" Margin="0,0,0,8"
                       Visibility="{Binding HasPresetPassword, Converter={StaticResource Vis}}"/>
            <Grid MaxWidth="560" HorizontalAlignment="Left" Visibility="{Binding HasPresetPassword, Converter={StaticResource NotVis}}">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="260"/>
              </Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock Text="{DynamicResource s.pw.password}" Style="{StaticResource Text.Label}"/>
                <v:SecretInput x:Name="Pw" ShowMeter="True" Label="{DynamicResource s.pw.password}"/>
              </StackPanel>
              <StackPanel Grid.Column="2">
                <TextBlock Text="{DynamicResource s.pw.confirm}" Style="{StaticResource Text.Label}"/>
                <v:SecretInput x:Name="Confirm" Label="{DynamicResource s.pw.confirm}"/>
              </StackPanel>
            </Grid>
            <CheckBox Content="{DynamicResource s.compress.encNames}" IsChecked="{Binding EncryptNames}" Margin="0,10,0,0" Visibility="{Binding IsSevenZip, Converter={StaticResource Vis}}"/>
            <StackPanel Orientation="Horizontal" Margin="0,10,0,0" Visibility="{Binding IsZip, Converter={StaticResource Vis}}">
              <TextBlock Text="{DynamicResource s.compress.zipMethod}" VerticalAlignment="Center" Margin="0,0,10,0"/>
              <ComboBox Width="220" ItemsSource="{Binding ZipEncryptions}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding ZipEncryption}"/>
            </StackPanel>
            <ItemsControl ItemsSource="{Binding Warnings}" Margin="0,10,0,0">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <StackPanel Orientation="Horizontal" Margin="0,2">
                    <TextBlock Text="&#xE7BA;" FontFamily="{StaticResource Font.Icons}" Foreground="{DynamicResource Brush.Warning}" VerticalAlignment="Top" Margin="0,2,8,0"/>
                    <TextBlock Text="{Binding}" TextWrapping="Wrap" MaxWidth="760" Foreground="{DynamicResource Brush.Warning}"/>
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </StackPanel>
      </Border>

      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button Style="{StaticResource Button.Accent}" Command="{Binding StartCommand}" Padding="22,8">
          <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE768;" FontFamily="{StaticResource Font.Icons}" VerticalAlignment="Center"/><TextBlock Text="{DynamicResource s.compress.start}" Margin="8,0,0,0"/></StackPanel>
        </Button>
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</UserControl>
