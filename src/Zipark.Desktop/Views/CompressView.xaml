<UserControl x:Class="Zipark.Desktop.Views.CompressView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="clr-namespace:Zipark.Desktop.Views"
             xmlns:infra="clr-namespace:Zipark.Desktop.Infrastructure">
  <UserControl.Resources>
    <infra:BoolToVisibilityConverter x:Key="Vis"/>
    <infra:BoolToVisibilityConverter x:Key="NotVis" Invert="True"/>
  </UserControl.Resources>

  <!-- Fixed two-column layout: no page scrolling. -->
  <Grid Margin="28,20,28,16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <StackPanel Margin="0,0,0,12">
      <TextBlock Text="{DynamicResource s.compress.title}" Style="{StaticResource Text.Title}"/>
      <TextBlock Text="{DynamicResource s.compress.subtitle}" Style="{StaticResource Text.Subtitle}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
    </StackPanel>

    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="5*"/>
        <ColumnDefinition Width="14"/>
        <ColumnDefinition Width="6*"/>
      </Grid.ColumnDefinitions>

      <!-- Left: items + destination -->
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Border Style="{StaticResource Card}" Padding="14,12" Margin="0,0,0,12">
          <DockPanel>
            <TextBlock DockPanel.Dock="Top" Text="{DynamicResource s.compress.sources}" Style="{StaticResource Text.Section}" Margin="0,0,0,8"/>
            <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,8">
              <Button Content="{DynamicResource s.compress.addFiles}" Command="{Binding AddFilesCommand}" Margin="0,0,6,0" Padding="12,5"/>
              <Button Content="{DynamicResource s.compress.addFolder}" Command="{Binding AddFolderCommand}" Margin="0,0,6,0" Padding="12,5"/>
              <Button Content="{DynamicResource s.common.remove}" Command="{Binding RemoveCommand}" Margin="0,0,6,0" Padding="12,5"/>
              <Button Content="{DynamicResource s.common.clear}" Command="{Binding ClearCommand}" Style="{StaticResource Button.Subtle}" Padding="10,5"/>
            </WrapPanel>
            <TextBlock DockPanel.Dock="Bottom" Text="{Binding SourceSummary}" Style="{StaticResource Text.Muted}" FontSize="12" Margin="0,6,0,0"/>
            <ListBox ItemsSource="{Binding Sources}" SelectedItem="{Binding SelectedSource}"
                     Background="{DynamicResource Brush.Input}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="{DynamicResource s.compress.sources}">
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <StackPanel Orientation="Horizontal" Margin="2" ToolTip="{Binding}">
                    <TextBlock Text="&#xE8A5;" FontFamily="{StaticResource Font.Icons}" Foreground="{DynamicResource Brush.Accent}" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding}" Margin="8,0,0,0" TextTrimming="CharacterEllipsis" MaxWidth="360"/>
                  </StackPanel>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </DockPanel>
        </Border>
        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="14,12">
          <StackPanel>
            <TextBlock Text="{DynamicResource s.compress.output}" Style="{StaticResource Text.Section}" Margin="0,0,0,8"/>
            <DockPanel>
              <Button DockPanel.Dock="Right" Content="{DynamicResource s.common.browse}" Command="{Binding BrowseOutputCommand}" Margin="8,0,0,0"/>
              <TextBox Text="{Binding Output, UpdateSourceTrigger=PropertyChanged}" ToolTip="{Binding Output}" AutomationProperties.Name="{DynamicResource s.compress.output}"/>
            </DockPanel>
          </StackPanel>
        </Border>
      </Grid>

      <!-- Right: options -->
      <Border Grid.Column="2" Style="{StaticResource Card}" Padding="14,12">
        <StackPanel>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition/>
              <ColumnDefinition Width="10"/>
              <ColumnDefinition/>
              <ColumnDefinition Width="10"/>
              <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <StackPanel>
              <TextBlock Text="{DynamicResource s.compress.format}" Style="{StaticResource Text.Label}"/>
              <ComboBox ItemsSource="{Binding Formats}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Format}"/>
            </StackPanel>
            <StackPanel Grid.Column="2">
              <TextBlock Text="{DynamicResource s.compress.level}" Style="{StaticResource Text.Label}"/>
              <ComboBox ItemsSource="{Binding Levels}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Level}"/>
            </StackPanel>
            <StackPanel Grid.Column="4">
              <TextBlock Text="{DynamicResource s.compress.threads}" Style="{StaticResource Text.Label}"/>
              <ComboBox ItemsSource="{Binding ThreadChoices}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Threads}"/>
            </StackPanel>
          </Grid>

          <!-- Expert options -->
          <Grid Margin="0,10,0,0" Visibility="{Binding Expert, Source={x:Static infra:UiState.Instance}, Converter={StaticResource Vis}}">
            <Grid.ColumnDefinitions>
              <ColumnDefinition/>
              <ColumnDefinition Width="10"/>
              <ColumnDefinition/>
              <ColumnDefinition Width="10"/>
              <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <StackPanel>
              <TextBlock Text="{DynamicResource s.compress.method}" Style="{StaticResource Text.Label}"/>
              <ComboBox ItemsSource="{Binding Methods}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Method}"/>
            </StackPanel>
            <StackPanel Grid.Column="2" IsEnabled="{Binding IsSevenZip}">
              <TextBlock Text="{DynamicResource s.compress.dictionary}" Style="{StaticResource Text.Label}"/>
              <ComboBox ItemsSource="{Binding Dictionaries}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding DictionaryMb}"/>
            </StackPanel>
            <StackPanel Grid.Column="4" IsEnabled="{Binding IsSevenZip}">
              <TextBlock Text="{DynamicResource s.compress.solid}" Style="{StaticResource Text.Label}"/>
              <ComboBox ItemsSource="{Binding SolidModes}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding SolidMode}"/>
            </StackPanel>
          </Grid>

          <CheckBox Content="{DynamicResource s.compress.each}" IsChecked="{Binding EachSeparately}" Margin="0,10,0,2"/>
          <CheckBox Content="{DynamicResource s.compress.verify}" IsChecked="{Binding VerifyAfter}" Margin="0,2"/>

          <Border Height="1" Background="{DynamicResource Brush.Border}" Margin="0,8"/>

          <!-- Split -->
          <DockPanel IsEnabled="{Binding SupportsSplit}" LastChildFill="False">
            <CheckBox IsChecked="{Binding Split}" FontWeight="SemiBold" Content="{DynamicResource s.compress.split}" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <ComboBox Width="130" ItemsSource="{Binding SplitPresets}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding SplitPreset}"
                      Visibility="{Binding Split, Converter={StaticResource Vis}}"/>
            <TextBox Width="100" Margin="6,0,0,0" Text="{Binding CustomSplit, UpdateSourceTrigger=PropertyChanged}" ToolTip="{DynamicResource s.split.customHint}">
              <TextBox.Style>
                <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                  <Setter Property="Visibility" Value="Collapsed"/>
                  <Style.Triggers>
                    <MultiDataTrigger>
                      <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding Split}" Value="True"/>
                        <Condition Binding="{Binding IsCustomSplit}" Value="True"/>
                      </MultiDataTrigger.Conditions>
                      <Setter Property="Visibility" Value="Visible"/>
                    </MultiDataTrigger>
                  </Style.Triggers>
                </Style>
              </TextBox.Style>
            </TextBox>
          </DockPanel>

          <Border Height="1" Background="{DynamicResource Brush.Border}" Margin="0,8"/>

          <!-- Encryption -->
          <StackPanel IsEnabled="{Binding SupportsEncryption}">
            <CheckBox IsChecked="{Binding Encrypt}" FontWeight="SemiBold" Content="{DynamicResource s.compress.encrypt}"/>
            <StackPanel Margin="22,6,0,0" Visibility="{Binding Encrypt, Converter={StaticResource Vis}}">
              <TextBlock Text="{DynamicResource s.compress.presetPw}" Foreground="{DynamicResource Brush.Success}" Margin="0,0,0,6" TextWrapping="Wrap"
                         Visibility="{Binding HasPresetPassword, Converter={StaticResource Vis}}"/>
              <Grid Visibility="{Binding HasPresetPassword, Converter={StaticResource NotVis}}">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition/>
                  <ColumnDefinition Width="10"/>
                  <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                  <TextBlock Text="{DynamicResource s.pw.password}" Style="{StaticResource Text.Label}"/>
                  <v:SecretInput x:Name="Pw" ShowMeter="True" Label="{DynamicResource s.pw.password}"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                  <TextBlock Text="{DynamicResource s.pw.confirm}" Style="{StaticResource Text.Label}"/>
                  <v:SecretInput x:Name="Confirm" Label="{DynamicResource s.pw.confirm}"/>
                </StackPanel>
              </Grid>
              <CheckBox Content="{DynamicResource s.compress.encNames}" IsChecked="{Binding EncryptNames}" Margin="0,6,0,0" Visibility="{Binding IsSevenZip, Converter={StaticResource Vis}}"/>
              <StackPanel Orientation="Horizontal" Margin="0,6,0,0" Visibility="{Binding IsZip, Converter={StaticResource Vis}}">
                <TextBlock Text="{DynamicResource s.compress.zipMethod}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <ComboBox Width="200" ItemsSource="{Binding ZipEncryptions}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding ZipEncryption}"/>
              </StackPanel>
              <ItemsControl ItemsSource="{Binding Warnings}" Margin="0,6,0,0">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <DockPanel Margin="0,1">
                      <TextBlock Text="&#xE7BA;" FontFamily="{StaticResource Font.Icons}" FontSize="12" Foreground="{DynamicResource Brush.Warning}" VerticalAlignment="Top" Margin="0,2,6,0"/>
                      <TextBlock Text="{Binding}" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource Brush.Warning}"/>
                    </DockPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </StackPanel>
        </StackPanel>
      </Border>
    </Grid>

    <DockPanel Grid.Row="2" Margin="0,12,0,0" LastChildFill="False">
      <Button DockPanel.Dock="Right" Style="{StaticResource Button.Accent}" Command="{Binding StartCommand}" Padding="22,8">
        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE768;" FontFamily="{StaticResource Font.Icons}" VerticalAlignment="Center"/><TextBlock Text="{DynamicResource s.compress.start}" Margin="8,0,0,0"/></StackPanel>
      </Button>
    </DockPanel>
  </Grid>
</UserControl>
