<Window x:Class="Zipark.Desktop.Views.PasswordDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="clr-namespace:Zipark.Desktop.Views"
        Title="{DynamicResource s.pwdlg.title}" Width="420" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource Brush.Window}" FontFamily="{StaticResource Font.UI}" FontSize="14">
  <StackPanel Margin="20">
    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
      <TextBlock Text="&#xE72E;" FontFamily="{StaticResource Font.Icons}" FontSize="22" Foreground="{DynamicResource Brush.Accent}" VerticalAlignment="Center"/>
      <TextBlock Text="{DynamicResource s.pwdlg.title}" Style="{StaticResource Text.Section}" Margin="10,0,0,0" VerticalAlignment="Center"/>
    </StackPanel>
    <TextBlock x:Name="ArchiveText" Style="{StaticResource Text.Muted}" Margin="0,0,0,8"/>
    <TextBlock x:Name="RetryText" Text="{DynamicResource s.pwdlg.wrong}" Foreground="{DynamicResource Brush.Danger}" Margin="0,0,0,8" Visibility="Collapsed"/>
    <v:SecretInput x:Name="Input" Label="{DynamicResource s.pwdlg.title}"/>
    <TextBlock Text="{DynamicResource s.pwdlg.note}" Style="{StaticResource Text.Muted}" FontSize="12" Margin="0,10,0,0"/>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
      <Button Content="{DynamicResource s.common.ok}" Style="{StaticResource Button.Accent}" IsDefault="True" MinWidth="90" Click="OnOk"/>
      <Button Content="{DynamicResource s.common.cancel}" IsCancel="True" MinWidth="90" Margin="8,0,0,0"/>
    </StackPanel>
  </StackPanel>
</Window>
