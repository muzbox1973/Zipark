<UserControl x:Class="Zipark.Desktop.Views.DrivesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:infra="clr-namespace:Zipark.Desktop.Infrastructure">
  <UserControl.Resources>
    <infra:BoolToVisibilityConverter x:Key="Vis"/>
    <infra:BoolToVisibilityConverter x:Key="NotVis" Invert="True"/>
    <infra:BytesConverter x:Key="Bytes"/>
    <infra:EnumLocConverter x:Key="StateLoc" Prefix="drivestate"/>
  </UserControl.Resources>
  <Grid Margin="32,28,32,24">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition/>
    </Grid.RowDefinitions>
    <StackPanel>
      <TextBlock Text="{DynamicResource s.drives.title}" Style="{StaticResource Text.Title}"/>
      <TextBlock Text="{DynamicResource s.drives.subtitle}" Style="{StaticResource Text.Subtitle}" Margin="0,0,0,16"/>
    </StackPanel>

    <!-- WinFsp status -->
    <Border Grid.Row="1" Margin="0,0,0,12">
      <Border.Style>
        <Style TargetType="Border" BasedOn="{StaticResource Card}">
          <Style.Triggers>
            <DataTrigger Binding="{Binding WinFspInstalled}" Value="False">
              <Setter Property="BorderBrush" Value="{DynamicResource Brush.Warning}"/>
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </Border.Style>
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
          <Button Content="{DynamicResource s.drives.getWinFsp}" Command="{Binding GetWinFspCommand}" Margin="0,0,8,0" Visibility="{Binding WinFspInstalled, Converter={StaticResource NotVis}}"/>
          <Button Content="{DynamicResource s.common.refresh}" Command="{Binding RefreshCommand}"/>
        </StackPanel>
        <StackPanel>
          <TextBlock Text="{Binding WinFspStatus}" FontWeight="SemiBold" TextWrapping="Wrap"/>
          <TextBlock Text="{DynamicResource s.drives.winfspExplain}" Style="{StaticResource Text.Muted}" FontSize="12" Margin="0,4,0,0" Visibility="{Binding WinFspInstalled, Converter={StaticResource NotVis}}"/>
          <TextBlock Text="{DynamicResource s.drives.isoNote}" Style="{StaticResource Text.Muted}" FontSize="12" Margin="0,4,0,0"/>
        </StackPanel>
      </DockPanel>
    </Border>

    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,12">
      <Button Style="{StaticResource Button.Accent}" Command="{Binding MountCommand}">
        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xEDA2;" FontFamily="{StaticResource Font.Icons}" VerticalAlignment="Center"/><TextBlock Text="{DynamicResource s.drives.mount}" Margin="8,0,0,0"/></StackPanel>
      </Button>
      <TextBlock Text="{DynamicResource s.drives.letter}" VerticalAlignment="Center" Margin="16,0,8,0"/>
      <ComboBox Width="110" ItemsSource="{Binding Letters}" SelectedItem="{Binding Letter}"/>
    </StackPanel>

    <ListView Grid.Row="3" ItemsSource="{Binding Drives}">
      <ListView.View>
        <GridView>
          <GridViewColumn Width="70">
            <GridViewColumn.Header><TextBlock Text="{DynamicResource s.col.drive}"/></GridViewColumn.Header>
            <GridViewColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding Letter}" FontWeight="SemiBold" FontSize="15"/></DataTemplate></GridViewColumn.CellTemplate>
          </GridViewColumn>
          <GridViewColumn Width="260">
            <GridViewColumn.Header><TextBlock Text="{DynamicResource s.col.source}"/></GridViewColumn.Header>
            <GridViewColumn.CellTemplate>
              <DataTemplate>
                <StackPanel>
                  <TextBlock Text="{Binding SourceName}" TextTrimming="CharacterEllipsis"/>
                  <TextBlock Text="{Binding SourcePath}" FontSize="11" Foreground="{DynamicResource Brush.TextMuted}" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
              </DataTemplate>
            </GridViewColumn.CellTemplate>
          </GridViewColumn>
          <GridViewColumn Width="70">
            <GridViewColumn.Header><TextBlock Text="{DynamicResource s.col.format}"/></GridViewColumn.Header>
            <GridViewColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding Format}"/></DataTemplate></GridViewColumn.CellTemplate>
          </GridViewColumn>
          <GridViewColumn Width="90">
            <GridViewColumn.Header><TextBlock Text="{DynamicResource s.col.state}"/></GridViewColumn.Header>
            <GridViewColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding State, Converter={StaticResource StateLoc}}"/></DataTemplate></GridViewColumn.CellTemplate>
          </GridViewColumn>
          <GridViewColumn Width="70">
            <GridViewColumn.Header><TextBlock Text="{DynamicResource s.col.encrypted}"/></GridViewColumn.Header>
            <GridViewColumn.CellTemplate>
              <DataTemplate>
                <TextBlock Text="&#xE72E;" FontFamily="{StaticResource Font.Icons}" Foreground="{DynamicResource Brush.Accent}" Visibility="{Binding Encrypted, Converter={StaticResource Vis}}"/>
              </DataTemplate>
            </GridViewColumn.CellTemplate>
          </GridViewColumn>
          <GridViewColumn Width="90">
            <GridViewColumn.Header><TextBlock Text="{DynamicResource s.col.cache}"/></GridViewColumn.Header>
            <GridViewColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding CacheBytes, Converter={StaticResource Bytes}}"/></DataTemplate></GridViewColumn.CellTemplate>
          </GridViewColumn>
          <GridViewColumn Width="220">
            <GridViewColumn.Header><TextBlock Text=""/></GridViewColumn.Header>
            <GridViewColumn.CellTemplate>
              <DataTemplate>
                <StackPanel Orientation="Horizontal">
                  <Button Content="{DynamicResource s.action.openExplorer}" Padding="10,3" MinHeight="26" Margin="0,0,6,0"
                          Command="{Binding DataContext.OpenCommand, RelativeSource={RelativeSource AncestorType=ListView}}" CommandParameter="{Binding}"/>
                  <Button Content="{DynamicResource s.drives.unmount}" Padding="10,3" MinHeight="26"
                          Command="{Binding DataContext.UnmountCommand, RelativeSource={RelativeSource AncestorType=ListView}}" CommandParameter="{Binding}"/>
                </StackPanel>
              </DataTemplate>
            </GridViewColumn.CellTemplate>
          </GridViewColumn>
        </GridView>
      </ListView.View>
    </ListView>
    <TextBlock Grid.Row="3" Text="{DynamicResource s.drives.none}" Style="{StaticResource Text.Muted}" HorizontalAlignment="Center" VerticalAlignment="Center"
               Visibility="{Binding Drives.Count, Converter={StaticResource NotVis}}"/>
  </Grid>
</UserControl>
