<UserControl x:Class="Zipark.Desktop.Views.IsoView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="clr-namespace:Zipark.Desktop.Views"
             xmlns:infra="clr-namespace:Zipark.Desktop.Infrastructure">
  <UserControl.Resources>
    <infra:BoolToVisibilityConverter x:Key="Vis"/>
    <infra:BoolToVisibilityConverter x:Key="NotVis" Invert="True"/>
  </UserControl.Resources>
  <Grid Margin="32,28,32,24">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition/>
    </Grid.RowDefinitions>
    <StackPanel>
      <TextBlock Text="{DynamicResource s.iso.title}" Style="{StaticResource Text.Title}"/>
      <TextBlock Text="{DynamicResource s.iso.subtitle}" Style="{StaticResource Text.Subtitle}" Margin="0,0,0,16"/>
    </StackPanel>
    <WrapPanel Grid.Row="1" Margin="0,0,0,12">
      <Button Style="{StaticResource Button.Accent}" Command="{Binding OpenIsoCommand}" Margin="0,0,8,0">
        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE958;" FontFamily="{StaticResource Font.Icons}" VerticalAlignment="Center"/><TextBlock Text="{DynamicResource s.iso.open}" Margin="8,0,0,0"/></StackPanel>
      </Button>
      <Button Command="{Binding MountCommand}" Margin="0,0,8,0">
        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xEDA2;" FontFamily="{StaticResource Font.Icons}" VerticalAlignment="Center"/><TextBlock Text="{DynamicResource s.iso.mount}" Margin="8,0,0,0"/></StackPanel>
      </Button>
      <Button Command="{Binding UnmountCommand}" Margin="0,0,8,0">
        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xF847;" FontFamily="{StaticResource Font.Icons}" VerticalAlignment="Center"/><TextBlock Text="{DynamicResource s.iso.unmount}" Margin="8,0,0,0"/></StackPanel>
      </Button>
      <Button Command="{Binding OpenDriveCommand}" Margin="0,0,8,0">
        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xEC50;" FontFamily="{StaticResource Font.Icons}" VerticalAlignment="Center"/><TextBlock Text="{DynamicResource s.action.openExplorer}" Margin="8,0,0,0"/></StackPanel>
      </Button>
      <Button Command="{Binding ExtractSelectedCommand}" Margin="0,0,8,0" Content="{DynamicResource s.explorer.extractSel}"/>
      <Button Command="{Binding ExtractAllCommand}" Content="{DynamicResource s.explorer.extractAll}"/>
    </WrapPanel>
    <Border Grid.Row="2" Background="{DynamicResource Brush.AccentSoft}" CornerRadius="8" Padding="12,8" Margin="0,0,0,12" Visibility="{Binding HasArchive, Converter={StaticResource Vis}}">
      <StackPanel Orientation="Horizontal">
        <TextBlock Text="&#xEDA2;" FontFamily="{StaticResource Font.Icons}" Foreground="{DynamicResource Brush.Accent}" VerticalAlignment="Center"/>
        <TextBlock Text="{Binding DriveText}" Margin="10,0,0,0" VerticalAlignment="Center"/>
      </StackPanel>
    </Border>
    <v:ArchiveListView Grid.Row="3" Visibility="{Binding HasArchive, Converter={StaticResource Vis}}"/>
    <Border Grid.Row="3" Style="{StaticResource Card}" VerticalAlignment="Top" Visibility="{Binding HasArchive, Converter={StaticResource NotVis}}">
      <StackPanel HorizontalAlignment="Center" Margin="0,30">
        <TextBlock Text="&#xE958;" FontFamily="{StaticResource Font.Icons}" FontSize="36" HorizontalAlignment="Center" Foreground="{DynamicResource Brush.Accent}"/>
        <TextBlock Text="{DynamicResource s.iso.empty}" Margin="0,12,0,4" HorizontalAlignment="Center" FontWeight="SemiBold"/>
        <TextBlock Text="{DynamicResource s.iso.emptyHint}" Style="{StaticResource Text.Muted}" HorizontalAlignment="Center" TextAlignment="Center"/>
      </StackPanel>
    </Border>
  </Grid>
</UserControl>
