<UserControl x:Class="Zipark.Desktop.Views.JobsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:infra="clr-namespace:Zipark.Desktop.Infrastructure">
  <UserControl.Resources>
    <infra:BoolToVisibilityConverter x:Key="Vis"/>
    <infra:BoolToVisibilityConverter x:Key="NotVis" Invert="True"/>
    <infra:SpeedConverter x:Key="Speed"/>
    <infra:EtaConverter x:Key="Eta"/>
    <infra:BytesConverter x:Key="Bytes"/>
    <infra:EnumLocConverter x:Key="StageLoc" Prefix="stage"/>
    <infra:EnumLocConverter x:Key="KindLoc" Prefix="kind"/>
  </UserControl.Resources>
  <Grid Margin="32,28,32,24">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition/>
    </Grid.RowDefinitions>
    <StackPanel>
      <TextBlock Text="{DynamicResource s.jobs.title}" Style="{StaticResource Text.Title}"/>
      <TextBlock Text="{DynamicResource s.jobs.subtitle}" Style="{StaticResource Text.Subtitle}" Margin="0,0,0,16"/>
    </StackPanel>
    <DockPanel Grid.Row="1" Margin="0,0,0,12">
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
        <TextBlock Text="{DynamicResource s.jobs.parallel}" VerticalAlignment="Center" Margin="0,0,8,0"/>
        <ComboBox Width="70" ItemsSource="{Binding ParallelChoices}" SelectedItem="{Binding MaxParallel}"/>
      </StackPanel>
      <StackPanel Orientation="Horizontal">
        <Button Content="{DynamicResource s.jobs.cancelAll}" Command="{Binding CancelAllCommand}" Margin="0,0,8,0"/>
        <Button Content="{DynamicResource s.jobs.clear}" Command="{Binding ClearCommand}"/>
      </StackPanel>
    </DockPanel>

    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
      <ItemsControl ItemsSource="{Binding Jobs}" VirtualizingPanel.IsVirtualizing="True">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border Style="{StaticResource Card}" Margin="0,0,0,8" Padding="14,12">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                  <DockPanel>
                    <TextBlock DockPanel.Dock="Right" Text="{Binding Stage, Converter={StaticResource StageLoc}}" Foreground="{DynamicResource Brush.TextMuted}" Margin="12,0,0,0"/>
                    <TextBlock TextTrimming="CharacterEllipsis">
                      <Run Text="{Binding Request.Kind, Converter={StaticResource KindLoc}, Mode=OneWay}" Foreground="{DynamicResource Brush.Accent}" FontWeight="SemiBold"/>
                      <Run Text="  "/>
                      <Run Text="{Binding Title, Mode=OneWay}"/>
                    </TextBlock>
                  </DockPanel>
                  <ProgressBar Value="{Binding Percent, Mode=OneWay}" Maximum="100" Margin="0,8,0,6" Visibility="{Binding IsActive, Converter={StaticResource Vis}}"/>
                  <StackPanel Orientation="Horizontal" Visibility="{Binding IsActive, Converter={StaticResource Vis}}">
                    <TextBlock Foreground="{DynamicResource Brush.TextMuted}" FontSize="12">
                      <Run Text="{Binding Percent, StringFormat={}{0:F0}%, Mode=OneWay}"/>
                      <Run Text="  ·  "/>
                      <Run Text="{Binding Progress.BytesPerSecond, Converter={StaticResource Speed}, Mode=OneWay}"/>
                      <Run Text="  ·  ETA "/>
                      <Run Text="{Binding Progress.Eta, Converter={StaticResource Eta}, Mode=OneWay}"/>
                    </TextBlock>
                    <TextBlock Text="{Binding Progress.CurrentItem}" Foreground="{DynamicResource Brush.TextMuted}" FontSize="12" Margin="12,0,0,0" TextTrimming="CharacterEllipsis" MaxWidth="420"/>
                  </StackPanel>
                  <TextBlock Text="{Binding Result.Message}" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource Brush.Danger}" Margin="0,4,0,0"
                             Visibility="{Binding Result.Message, Converter={StaticResource Vis}}"/>
                  <TextBlock FontSize="12" Foreground="{DynamicResource Brush.TextMuted}" Margin="0,4,0,0" Visibility="{Binding Result.Success, Converter={StaticResource Vis}}">
                    <Run Text="{Binding Result.ElapsedSeconds, StringFormat={}{0:F1}s, Mode=OneWay}"/>
                    <Run Text="  ·  "/>
                    <Run Text="{Binding Result.OutputBytes, Converter={StaticResource Bytes}, Mode=OneWay}"/>
                  </TextBlock>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                  <Button Content="{DynamicResource s.action.openFolder}" Padding="10,3" MinHeight="26"
                          Command="{Binding DataContext.OpenOutputCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                          Visibility="{Binding Result.Success, Converter={StaticResource Vis}}"/>
                  <Button Content="{DynamicResource s.common.cancel}" Padding="10,3" MinHeight="26"
                          Command="{Binding DataContext.CancelCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                          Visibility="{Binding IsActive, Converter={StaticResource Vis}}"/>
                </StackPanel>
              </Grid>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>
    <TextBlock Grid.Row="2" Text="{DynamicResource s.jobs.none}" Style="{StaticResource Text.Muted}" HorizontalAlignment="Center" VerticalAlignment="Center"
               Visibility="{Binding Jobs.Count, Converter={StaticResource NotVis}}"/>
  </Grid>
</UserControl>
