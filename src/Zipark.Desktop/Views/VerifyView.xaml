<UserControl x:Class="Zipark.Desktop.Views.VerifyView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:infra="clr-namespace:Zipark.Desktop.Infrastructure">
  <UserControl.Resources>
    <infra:BytesConverter x:Key="Bytes"/>
    <Style x:Key="OkMark" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="{StaticResource Font.Icons}"/>
      <Setter Property="Text" Value=""/>
      <Style.Triggers>
        <DataTrigger Binding="{Binding Ok}" Value="True">
          <Setter Property="Text" Value="&#xE73E;"/>
          <Setter Property="Foreground" Value="{DynamicResource Brush.Success}"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding Ok}" Value="False">
          <Setter Property="Text" Value="&#xE711;"/>
          <Setter Property="Foreground" Value="{DynamicResource Brush.Danger}"/>
        </DataTrigger>
      </Style.Triggers>
    </Style>
  </UserControl.Resources>
  <Grid Margin="32,28,32,24">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition/>
    </Grid.RowDefinitions>
    <StackPanel>
      <TextBlock Text="{DynamicResource s.verify.title}" Style="{StaticResource Text.Title}"/>
      <TextBlock Text="{DynamicResource s.verify.subtitle}" Style="{StaticResource Text.Subtitle}" Margin="0,0,0,8"/>
    </StackPanel>
    <TabControl Grid.Row="1" SelectedIndex="{Binding Tab}">
      <TabItem Header="{DynamicResource s.verify.tabTest}">
        <DockPanel>
          <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10">
            <Button Content="{DynamicResource s.extract.add}" Command="{Binding AddArchivesCommand}" Margin="0,0,6,0"/>
            <Button Style="{StaticResource Button.Accent}" Content="{DynamicResource s.verify.test}" Command="{Binding TestCommand}" Margin="0,0,6,0"/>
            <Button Content="{DynamicResource s.common.clear}" Command="{Binding ClearArchivesCommand}" Style="{StaticResource Button.Subtle}"/>
          </StackPanel>
          <ListView ItemsSource="{Binding Archives}">
            <ListView.View>
              <GridView>
                <GridViewColumn Width="34">
                  <GridViewColumn.CellTemplate><DataTemplate><TextBlock Style="{StaticResource OkMark}"/></DataTemplate></GridViewColumn.CellTemplate>
                </GridViewColumn>
                <GridViewColumn Width="300">
                  <GridViewColumn.Header><TextBlock Text="{DynamicResource s.col.name}"/></GridViewColumn.Header>
                  <GridViewColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding Name}" ToolTip="{Binding Path}"/></DataTemplate></GridViewColumn.CellTemplate>
                </GridViewColumn>
                <GridViewColumn Width="100">
                  <GridViewColumn.Header><TextBlock Text="{DynamicResource s.col.size}"/></GridViewColumn.Header>
                  <GridViewColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding Size, Converter={StaticResource Bytes}}"/></DataTemplate></GridViewColumn.CellTemplate>
                </GridViewColumn>
                <GridViewColumn Width="420">
                  <GridViewColumn.Header><TextBlock Text="{DynamicResource s.col.result}"/></GridViewColumn.Header>
                  <GridViewColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding Status}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Status}"/></DataTemplate></GridViewColumn.CellTemplate>
                </GridViewColumn>
              </GridView>
            </ListView.View>
          </ListView>
        </DockPanel>
      </TabItem>
      <TabItem Header="{DynamicResource s.verify.tabHash}">
        <DockPanel>
          <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,10">
            <Button Content="{DynamicResource s.compress.addFiles}" Command="{Binding AddFilesCommand}" Margin="0,0,6,0"/>
            <Button Style="{StaticResource Button.Accent}" Content="{DynamicResource s.verify.compute}" Command="{Binding ComputeCommand}" Margin="0,0,6,0"/>
            <Button Content="{DynamicResource s.verify.saveManifest}" Command="{Binding SaveManifestCommand}" Margin="0,0,6,0"/>
            <Button Content="{DynamicResource s.verify.checkManifest}" Command="{Binding VerifyManifestCommand}" Margin="0,0,6,0"/>
            <Button Content="{DynamicResource s.common.clear}" Command="{Binding ClearFilesCommand}" Style="{StaticResource Button.Subtle}"/>
          </WrapPanel>
          <ListView ItemsSource="{Binding Files}">
            <ListView.View>
              <GridView>
                <GridViewColumn Width="34">
                  <GridViewColumn.CellTemplate><DataTemplate><TextBlock Style="{StaticResource OkMark}"/></DataTemplate></GridViewColumn.CellTemplate>
                </GridViewColumn>
                <GridViewColumn Width="220">
                  <GridViewColumn.Header><TextBlock Text="{DynamicResource s.col.name}"/></GridViewColumn.Header>
                  <GridViewColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding Name}" ToolTip="{Binding Path}"/></DataTemplate></GridViewColumn.CellTemplate>
                </GridViewColumn>
                <GridViewColumn Width="90">
                  <GridViewColumn.Header><TextBlock Text="{DynamicResource s.col.size}"/></GridViewColumn.Header>
                  <GridViewColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding Size, Converter={StaticResource Bytes}}"/></DataTemplate></GridViewColumn.CellTemplate>
                </GridViewColumn>
                <GridViewColumn Width="90" Header="CRC32">
                  <GridViewColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding Crc32}" FontFamily="Consolas"/></DataTemplate></GridViewColumn.CellTemplate>
                </GridViewColumn>
                <GridViewColumn Width="300" Header="SHA-256">
                  <GridViewColumn.CellTemplate>
                    <DataTemplate>
                      <TextBlock Text="{Binding Sha256}" FontFamily="Consolas" TextTrimming="CharacterEllipsis" ToolTip="{Binding Sha256}" Cursor="Hand">
                        <TextBlock.InputBindings>
                          <MouseBinding Gesture="LeftDoubleClick" Command="{Binding DataContext.CopyCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding Sha256}"/>
                        </TextBlock.InputBindings>
                      </TextBlock>
                    </DataTemplate>
                  </GridViewColumn.CellTemplate>
                </GridViewColumn>
                <GridViewColumn Width="120">
                  <GridViewColumn.Header><TextBlock Text="{DynamicResource s.col.result}"/></GridViewColumn.Header>
                  <GridViewColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding Status}"/></DataTemplate></GridViewColumn.CellTemplate>
                </GridViewColumn>
              </GridView>
            </ListView.View>
          </ListView>
        </DockPanel>
      </TabItem>
    </TabControl>
  </Grid>
</UserControl>
