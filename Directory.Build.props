<Project>
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier Condition="'$(OutputType)' == 'Exe' or '$(OutputType)' == 'WinExe'">win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <Version>1.0.4</Version>
    <Company>GPT PARK</Company>
    <Authors>GPT PARK</Authors>
    <Product>Zipark</Product>
    <Copyright>Copyright (c) 2026 GPT PARK. MIT License.</Copyright>
    <PackageProjectUrl>https://gptparkai.com/</PackageProjectUrl>
    <RepositoryUrl>https://github.com/muzbox1973/Zipark</RepositoryUrl>
    <NeutralLanguage>ko-KR</NeutralLanguage>
    <SatelliteResourceLanguages>ko;en</SatelliteResourceLanguages>
    <Deterministic>true</Deterministic>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CA1416</NoWarn>
  </PropertyGroup>
</Project>
