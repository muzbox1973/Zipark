<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs" xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">
  <Package Name="Zipark" Manufacturer="GPT PARK" Version="$(ProductVersion).0"
           UpgradeCode="DE28E8D9-B6CC-4053-8104-ABEEDD8F4532" Scope="perMachine" Language="1042" Codepage="949">
    <SummaryInformation Description="Zipark - 무료 오픈소스 압축 프로그램" Codepage="949" Comments="Zipark(개발: GPT PARK)를 설치합니다. 무료 오픈소스 압축 프로그램, MIT 라이선스." />
    <MajorUpgrade DowngradeErrorMessage="이미 더 새로운 버전의 Zipark가 설치되어 있습니다." />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <Icon Id="ZiparkIcon" SourceFile="..\..\src\Zipark.Desktop\Assets\Zipark.ico" />
    <Property Id="ARPPRODUCTICON" Value="ZiparkIcon" />
    <Property Id="ARPURLINFOABOUT" Value="https://gptparkai.com/" />
    <Property Id="ARPHELPLINK" Value="https://www.youtube.com/@AIFACT-GPTPARK" />
    <Property Id="ARPURLUPDATEINFO" Value="https://github.com/muzbox1973/Zipark" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="Zipark" />
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="StartMenuDir" Name="Zipark" />
    </StandardDirectory>

    <!-- Main executable is declared explicitly so custom actions and the shortcut can reference it. -->
    <ComponentGroup Id="AppFiles" Directory="INSTALLFOLDER">
      <Component Id="MainExe">
        <File Id="ZiparkExe" Source="$(PublishDir)Zipark.exe" KeyPath="yes" />
      </Component>
      <Files Include="$(PublishDir)**">
        <Exclude Files="$(PublishDir)Zipark.exe" />
        <Exclude Files="$(PublishDir)**\*.pdb" />
      </Files>
    </ComponentGroup>

    <Component Id="StartMenuShortcut" Directory="StartMenuDir" Guid="A53F65C4-C7E0-4B51-BA18-9F41B7B1367D">
      <Shortcut Id="AppShortcut" Name="Zipark" Description="무료 오픈소스 압축 프로그램" Target="[INSTALLFOLDER]Zipark.exe" WorkingDirectory="INSTALLFOLDER" Icon="ZiparkIcon" />
      <RemoveFolder Id="RemoveStartMenuDir" On="uninstall" />
      <RegistryValue Root="HKCU" Key="Software\Zipark" Name="StartMenuShortcut" Type="integer" Value="1" KeyPath="yes" />
    </Component>

    <Feature Id="Main" Title="Zipark" Level="1">
      <ComponentGroupRef Id="AppFiles" />
      <ComponentRef Id="StartMenuShortcut" />
    </Feature>

    <!--
      Explorer integration lives in HKCU and is written by the app itself (no admin rights needed).
      Installing registers it for the installing user; uninstalling removes it. Failures never block setup.
    -->
    <CustomAction Id="RegisterShell" FileRef="ZiparkExe" ExeCommand="--register-shell" Execute="deferred" Impersonate="yes" Return="ignore" />
    <CustomAction Id="UnregisterShell" FileRef="ZiparkExe" ExeCommand="--unregister-shell" Execute="deferred" Impersonate="yes" Return="ignore" />
    <InstallExecuteSequence>
      <Custom Action="RegisterShell" After="InstallFiles" Condition="NOT REMOVE" />
      <Custom Action="UnregisterShell" Before="RemoveFiles" Condition="REMOVE=&quot;ALL&quot;" />
    </InstallExecuteSequence>

    <ui:WixUI Id="WixUI_InstallDir" InstallDirectory="INSTALLFOLDER" />
    <WixVariable Id="WixUILicenseRtf" Value="License.rtf" />
  </Package>
</Wix>
