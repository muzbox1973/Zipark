<Project Sdk="WixToolset.Sdk/5.0.2">
  <!--
    WiX Toolset v5 (MS-RL). Build through build/build-release.ps1, which first publishes the
    self-contained app into artifacts/publish (and the 7-Zip engine into artifacts/publish/engine).
  -->
  <PropertyGroup>
    <OutputName>Zipark-$(Version)-x64</OutputName>
    <Platform>x64</Platform>
    <InstallerPlatform>x64</InstallerPlatform>
    <PublishDir Condition="'$(PublishDir)' == ''">$(MSBuildThisFileDirectory)..\..\artifacts\publish\</PublishDir>
    <DefineConstants>PublishDir=$(PublishDir);ProductVersion=$(Version)</DefineConstants>
    <SuppressValidation>false</SuppressValidation>
    <!-- Korean installer UI (WixUI ko-KR strings) -->
    <Cultures>ko-KR</Cultures>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="WixToolset.UI.wixext" Version="5.0.2" />
  </ItemGroup>
</Project>
